  "business_process_specific_kpis": [
    {
      "kpi_name": "Scenario Provisioning Lead Time",
      "definition": "Average engineering hours required to configure and run the first representative validation scenario for a candidate automation.",
      "calculation": "sum(hours_from_request_to_first_successful_scenario) / candidate_automations_tested",
      "unit": "hours",
      "direction": "lower_is_better",
      "target": "<= 1.5 hours per candidate",
      "source_fields": [
        "candidate_automation_id",
        "scenario_requested_at",
        "first_successful_scenario_at"
      ],
      "reporting_cadence": "monthly",
      "owner_group": "Automation Engineering"
    },
    {
      "kpi_name": "Execution Model Validation Coverage",
      "definition": "Percent of candidates for which execution model, stop behavior, exception path, and retry or queue behavior were exercised before production integration.",
      "calculation": "candidates_with_completed_validation_checklist / candidates_using_simulacrum",
      "unit": "percent",
      "direction": "higher_is_better",
      "target": ">= 95%",
      "source_fields": [
        "candidate_automation_id",
        "validation_checklist_status"
      ],
      "reporting_cadence": "monthly",
      "owner_group": "Automation Center of Excellence"
    },
    {
      "kpi_name": "Queue Record Reconciliation Accuracy",
      "definition": "Percent of generated transactional records reconciled to exactly one queue item and one terminal transaction outcome.",
      "calculation": "records_with_one_queue_item_and_one_terminal_outcome / generated_transactional_records",
      "unit": "percent",
      "direction": "higher_is_better",
      "target": "100%",
      "source_fields": [
        "transaction_reference",
        "queue_item_id",
        "terminal_status"
      ],
      "reporting_cadence": "per scenario and monthly",
      "owner_group": "UiPath Platform Engineering"
    },
    {
      "kpi_name": "Failure Classification Accuracy",
      "definition": "Percent of injected failure scenarios recorded with the expected business or application exception classification.",
      "calculation": "failures_with_expected_classification / injected_failures",
      "unit": "percent",
      "direction": "higher_is_better",
      "target": "100%",
      "source_fields": [
        "expected_exception_type",
        "actual_exception_type"
      ],
      "reporting_cadence": "per scenario and monthly",
      "owner_group": "Automation Engineering"
    },
    {
      "kpi_name": "Telemetry Completeness Rate",
      "definition": "Percent of processed records containing all mandatory standard log fields and configured, source-present Insights custom fields.",
      "calculation": "records_with_complete_required_telemetry / records_processed",
      "unit": "percent",
      "direction": "higher_is_better",
      "target": ">= 99%",
      "source_fields": [
        "transaction_reference",
        "required_standard_fields_present",
        "required_custom_fields_present"
      ],
      "reporting_cadence": "weekly",
      "owner_group": "Automation Center of Excellence"
    }
